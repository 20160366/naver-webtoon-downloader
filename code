import os
import time
import requests

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options


# ==========================================
# 설정
# ==========================================

URL = "https://comic.naver.com/webtoon/detail?titleId=821597&no=109&week=tue"

SAVE_FOLDER = "images"

os.makedirs(SAVE_FOLDER, exist_ok=True)


# ==========================================
# Chrome 설정
# ==========================================

options = Options()

# 브라우저 창을 보고 싶으면 그대로 실행
# 안 보이게 하려면 아래 줄의 주석을 제거
# options.add_argument("--headless")

options.add_argument("--window-size=1920,1080")

driver = webdriver.Chrome(options=options)


# ==========================================
# 웹툰 페이지 열기
# ==========================================

print("페이지 접속 중...")

driver.get(URL)

# 페이지 로딩 기다리기
time.sleep(5)


# ==========================================
# 웹툰 본문 영역 찾기
# ==========================================

try:

    comic_area = driver.find_element(
        By.ID,
        "comic_view_area"
    )

    print("웹툰 본문 영역 찾음!")

except Exception as e:

    print("웹툰 본문 영역을 찾지 못했습니다.")
    print("오류:", e)

    driver.quit()
    exit()


# ==========================================
# 본문 안의 이미지 찾기
# ==========================================

image_elements = comic_area.find_elements(
    By.TAG_NAME,
    "img"
)

print(
    f"웹툰 본문에서 찾은 이미지: {len(image_elements)}개"
)

print("-" * 60)


# ==========================================
# 이미지 URL 수집
# ==========================================

image_urls = []


for i, img in enumerate(image_elements):

    # src
    src = img.get_attribute("src")

    # src가 없으면 data-src
    if not src:
        src = img.get_attribute("data-src")

    # data-original도 확인
    if not src:
        src = img.get_attribute("data-original")

    if not src:
        print(f"[{i}] 이미지 URL 없음")
        continue

    # 중복 제거
    if src not in image_urls:

        image_urls.append(src)

        print(
            f"[{len(image_urls)-1}] {src}"
        )


print("-" * 60)

print(
    f"실제로 다운로드할 이미지: {len(image_urls)}개"
)


# ==========================================
# Selenium 종료
# ==========================================

driver.quit()


# ==========================================
# 이미지 다운로드
# ==========================================

headers = {
    "User-Agent": "Mozilla/5.0",
    "Referer": URL
}


saved_count = 0


for i, image_url in enumerate(image_urls):

    print()
    print(f"[{i+1}/{len(image_urls)}] 다운로드 중")
    print(image_url)

    try:

        response = requests.get(
            image_url,
            headers=headers,
            timeout=20
        )

        print(
            "Status:",
            response.status_code
        )

        content_type = response.headers.get(
            "Content-Type",
            ""
        )

        print(
            "Content-Type:",
            content_type
        )


        # --------------------------------------
        # 이미지인지 확인
        # --------------------------------------

        if not content_type.startswith("image/"):

            print("❌ 이미지가 아닌 응답입니다.")
            continue


        # --------------------------------------
        # 확장자 결정
        # --------------------------------------

        extension = content_type.split("/")[-1]

        if extension == "jpeg":
            extension = "jpg"

        elif extension == "svg+xml":
            extension = "svg"


        # --------------------------------------
        # 파일 저장
        # --------------------------------------

        filename = (
            f"image_{saved_count + 1:03d}.{extension}"
        )

        filepath = os.path.join(
            SAVE_FOLDER,
            filename
        )


        with open(
            filepath,
            "wb"
        ) as f:

            f.write(
                response.content
            )


        print(
            "✅ 저장 완료:",
            filepath
        )

        saved_count += 1


    except requests.RequestException as e:

        print(
            "❌ 다운로드 실패:",
            e
        )


# ==========================================
# 완료
# ==========================================

print()
print("=" * 60)

print(
    f"완료! 총 {saved_count}개 이미지 저장"
)

print(
    "저장 위치:",
    os.path.abspath(SAVE_FOLDER)
)
